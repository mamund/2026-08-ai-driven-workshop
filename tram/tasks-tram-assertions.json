{
  "manifestVersion": "0.2",
  "version": "1.0.0",
  "name": "Task Management API \u2014 Generated TRAM Assertion Collection",
  "description": "Generated from the Task Management API Story and associated OpenAPI document. Tests are tagged by TRAM behavioral level. Story semantics are treated as normative; OpenAPI supplies HTTP paths, methods, parameters, schemas, and response status choices.",
  "config": {
    "baseUrl": "http://localhost:3000",
    "timeoutMs": 5000,
    "defaultHeaders": {
      "accept": "application/json"
    }
  },
  "data": {
    "seed": {
      "id": "${uuid}",
      "title": "TRAM generated seed task",
      "description": "Seed task used by generated assertions",
      "dueDate": "2026-12-15",
      "status": "active",
      "priority": 3,
      "assignedUser": "alice"
    },
    "edit": {
      "title": "TRAM edited seed task",
      "description": "Edited by generated TRAM assertions",
      "dueDate": "2026-12-20",
      "status": "active",
      "priority": 4,
      "assignedUser": "bob"
    },
    "workflow": {
      "id": "${uuid}",
      "title": "TRAM workflow task",
      "description": "Task used for accumulated workflow verification",
      "dueDate": "2027-01-15",
      "status": "active",
      "priority": 2,
      "assignedUser": "carol"
    },
    "governance": {
      "duplicateId": "${uuid}",
      "generatedIdTitle": "TRAM server-generated identifier task",
      "invalidStatusId": "${uuid}",
      "invalidPriorityId": "${uuid}",
      "missingTitleId": "${uuid}",
      "missingStatusId": "${uuid}"
    }
  },
  "tests": [
    {
      "id": "surface-home",
      "name": "Reach home resource",
      "description": "Verify the OpenAPI home operation is reachable.",
      "tags": [
        "level-0",
        "surface",
        "safe"
      ],
      "method": "GET",
      "path": "/goShowHomePage",
      "expect": {
        "status": 200,
        "headers": [
          {
            "name": "content-type",
            "contains": "application/json"
          }
        ]
      }
    },
    {
      "id": "surface-task-collection",
      "name": "Reach task collection",
      "description": "Verify the task collection operation is reachable.",
      "tags": [
        "level-0",
        "surface",
        "safe"
      ],
      "method": "GET",
      "path": "/goGetTaskCollection",
      "expect": {
        "status": 200,
        "headers": [
          {
            "name": "content-type",
            "contains": "application/json"
          }
        ]
      }
    },
    {
      "id": "surface-filtered-task-collection",
      "name": "Reach filtered task collection",
      "description": "Verify the filtered collection operation is reachable without filters.",
      "tags": [
        "level-0",
        "surface",
        "safe"
      ],
      "method": "GET",
      "path": "/goGetFilteredTaskCollection",
      "expect": {
        "status": 200,
        "headers": [
          {
            "name": "content-type",
            "contains": "application/json"
          }
        ]
      }
    },
    {
      "id": "shape-task-collection",
      "name": "Task collection has expected shape",
      "description": "Verify collection and required TaskItem properties. Optional property checks follow the Story's data-property definitions where TRAM can express them.",
      "tags": [
        "level-1",
        "shape",
        "collection"
      ],
      "method": "GET",
      "path": "/goGetTaskCollection",
      "expect": {
        "status": 200,
        "body": [
          {
            "path": "$",
            "isArray": true
          },
          {
            "path": "$",
            "each": {
              "hasProperties": [
                "id",
                "title",
                "status"
              ]
            }
          },
          {
            "path": "$",
            "each": {
              "property": "id",
              "type": "string"
            }
          },
          {
            "path": "$",
            "each": {
              "property": "title",
              "type": "string"
            }
          },
          {
            "path": "$",
            "each": {
              "property": "status",
              "oneOf": [
                "active",
                "completed"
              ]
            }
          },
          {
            "path": "$",
            "each": {
              "property": "description",
              "optional": true,
              "type": "string"
            }
          },
          {
            "path": "$",
            "each": {
              "property": "dueDate",
              "optional": true,
              "type": "string"
            }
          },
          {
            "path": "$",
            "each": {
              "property": "priority",
              "optional": true,
              "type": "number"
            }
          },
          {
            "path": "$",
            "each": {
              "property": "priority",
              "optional": true,
              "range": {
                "min": 1,
                "max": 5
              }
            }
          },
          {
            "path": "$",
            "each": {
              "property": "assignedUser",
              "optional": true,
              "type": "string"
            }
          }
        ]
      }
    },
    {
      "id": "unsafe-create-seed",
      "name": "Create seed task",
      "description": "Create a known task used by later item, filtering, and mutation assertions.",
      "tags": [
        "level-3",
        "unsafe",
        "create",
        "setup"
      ],
      "method": "POST",
      "path": "/doCreateNewTask",
      "headers": {
        "content-type": "application/json"
      },
      "bodyType": "json",
      "body": "$data.seed",
      "expect": {
        "status": 200,
        "headers": [
          {
            "name": "content-type",
            "contains": "application/json"
          }
        ],
        "body": [
          {
            "path": "$",
            "isArray": true
          }
        ]
      }
    },
    {
      "id": "safe-get-task-item",
      "name": "Get a single existing task",
      "description": "Retrieve the seed task by the id required by the API Story.",
      "tags": [
        "level-2",
        "safe",
        "lookup"
      ],
      "method": "GET",
      "path": "/goGetTaskItem",
      "query": {
        "id": "${data.seed.id}"
      },
      "expect": {
        "status": 200,
        "body": [
          {
            "path": "$",
            "hasProperties": [
              "id",
              "title",
              "status"
            ]
          },
          {
            "path": "$.id",
            "equals": "${data.seed.id}"
          },
          {
            "path": "$.title",
            "equals": "${data.seed.title}"
          },
          {
            "path": "$.status",
            "equals": "active"
          }
        ]
      }
    },
    {
      "id": "safe-filter-title",
      "name": "Filter tasks by title",
      "tags": [
        "level-2",
        "safe",
        "filter"
      ],
      "method": "GET",
      "path": "/goGetFilteredTaskCollection",
      "query": {
        "title": "${data.seed.title}"
      },
      "expect": {
        "status": 200,
        "body": [
