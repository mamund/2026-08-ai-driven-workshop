          },
          {
            "path": "$.title",
            "equals": "${data.edit.title}"
          },
          {
            "path": "$.status",
            "equals": "active"
          },
          {
            "path": "$.priority",
            "equals": 4
          },
          {
            "path": "$.assignedUser",
            "equals": "${data.edit.assignedUser}"
          }
        ]
      }
    },
