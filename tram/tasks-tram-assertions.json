              "min": 1
            }
          },
          {
            "path": "$",
            "each": {
              "property": "assignedUser",
              "equals": "${data.seed.assignedUser}"
            }
          }
        ]
      }
    },
    {
      "id": "safe-reject-unknown-task",
      "name": "Reject unknown task lookup",
      "description": "OpenAPI documents 404 for resource not found.",
      "tags": [
        "level-2",
        "safe",
        "lookup",
        "sad-path"
      ],
      "method": "GET",
      "path": "/goGetTaskItem",
      "query": {
        "id": "${uuid}"
      },
      "expect": {
        "status": 404
      }
    },
    {
      "id": "unsafe-edit-task",
      "name": "Edit an existing task",
