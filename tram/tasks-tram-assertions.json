    {
      "id": "governance-create-without-id",
      "name": "Service generates id when create omits id",
      "description": "Normative Story rule. This intentionally conflicts with OpenAPI, which marks id required for creation. OpenAPI's documented 200 success status is used.",
      "tags": [
        "level-5",
        "governance",
        "id",
        "story-normative",
        "openapi-conflict"
      ],
      "method": "POST",
      "path": "/doCreateNewTask",
      "headers": {
        "content-type": "application/json"
      },
      "bodyType": "json",
      "body": {
        "title": "${data.governance.generatedIdTitle}",
        "status": "active"
      },
      "expect": {
        "status": 200,
        "body": [
          {
            "path": "$",
            "isArray": true
          }
        ]
      }
    },
