    },
    {
      "id": "governance-reject-priority-out-of-range",
      "name": "Reject priority outside 1 through 5",
      "description": "The Story defines priority as a numeric value between 1 and 5. OpenAPI incorrectly models priority as string and does not encode the range.",
      "tags": [
        "level-5",
        "governance",
        "priority",
        "sad-path",
        "story-normative",
        "openapi-conflict"
      ],
      "method": "POST",
      "path": "/doCreateNewTask",
      "headers": {
        "content-type": "application/json"
      },
