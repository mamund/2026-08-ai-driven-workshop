    {
      "id": "governance-reject-invalid-status",
      "name": "Reject status outside the Story value set",
      "description": "The Story defines status as active or completed. OpenAPI does not encode this enum, so this assertion is Story-derived and uses OpenAPI's 400 Invalid input response.",
      "tags": [
        "level-5",
        "governance",
        "status",
        "sad-path",
        "openapi-gap"
      ],
      "method": "POST",
      "path": "/doCreateNewTask",
      "headers": {
